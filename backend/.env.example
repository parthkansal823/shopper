# Copy to backend/.env and fill in. Never commit the real .env.

# ----- App -----
APP_NAME=Shopper API
APP_ENV=development          # "production" turns on strict config checks
DEBUG=true

# ----- MongoDB -----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=shopper

# ----- Public URLs (no trailing slash) -----
# FRONTEND_URL builds the reschedule/cancel links sent to invitees.
# API_PUBLIC_URL builds the iCal subscription URL.
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Auth -----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the app refuses to start if this is unset, default, or <32 chars.
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_REGISTRATION=true

# ----- Behaviour -----
SEED_ON_STARTUP=false        # demo data; only applies to an empty database
RUN_MIGRATIONS_ON_STARTUP=true
DEFAULT_TIMEZONE=Asia/Kolkata

# ----- Reminder scheduler -----
REMINDER_SCHEDULER_ENABLED=true
REMINDER_POLL_SECONDS=60

# ----- SMTP -----
# Leave blank in development: emails are printed to the server log instead,
# and the booking OTP is surfaced in the UI so you can complete a booking.
# Gmail needs an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Shopper
SMTP_TIMEOUT_SECONDS=10
SMTP_RETRY_COUNT=1

# ----- Google OAuth (optional) -----
# Leave blank to hide the Google sign-in button and calendar sync entirely.
# Sign-in and calendar access are separate grants: BOTH redirect URIs below
# must be registered in the Google console, matched exactly.
# Calendar sync also needs the client secret — it refreshes tokens offline.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/auth/google/calendar/callback

# ----- OTP -----
OTP_TTL_SECONDS=600
OTP_RATE_LIMIT_SECONDS=60
OTP_MAX_ATTEMPTS=5
VERIFICATION_TOKEN_TTL_SECONDS=900

# ----- Rate limiting -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_BOOKING=10
RATE_LIMIT_BOOKING_WINDOW=3600
RATE_LIMIT_OTP=8
RATE_LIMIT_OTP_WINDOW=3600
